PORT=3000
HOST=127.0.0.1
NODE_ENV=development
PICKSY_DB_PATH=data/picksy.sqlite

# Create an OAuth 2.0 Client ID of type "Web application" in Google Cloud.
# Add this exact URL to Authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Enable Places API (New) and billing in Google Cloud; keep this server key restricted.
GOOGLE_PLACES_API_KEY=
